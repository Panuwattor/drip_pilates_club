# ===== ที่เก็บไฟล์อัปโหลด (รูปประกาศ / avatar ครู / ปกคลิป / สลิป) =====
# public = เก็บในเครื่อง (ต้องรัน php artisan storage:link), r2 = Cloudflare R2
MEDIA_DISK=public

# ===== Cloudflare R2 ===== (ตั้ง MEDIA_DISK=r2 เพื่อเริ่มใช้)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
# S3 API endpoint จากหน้า Settings แต่ตัดชื่อ bucket ท้ายออก
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# public URL: เอามาจากแท็บ Public Development URL (pub-xxxx.r2.dev) หรือ custom domain
R2_URL=https://pub-<hash>.r2.dev
